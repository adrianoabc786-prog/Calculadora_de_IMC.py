def calcular_imc(peso: float, altura: float) -> float:
    """Realiza o cálculo do IMC."""
    return peso / (altura ** 2)

def obter_classificacao(imc: float) -> str:
    """Retorna a classificação com base no valor do IMC calculado."""
    if imc < 18.5:
        return 'Abaixo do peso'
    elif 18.5 <= imc < 25:
        return 'Peso normal'
    elif 25 <= imc < 30:
        return 'Sobrepeso'
    else:
        return 'Obesidade'

def executar_calculadora() -> None:
    print('=== Calculadora de IMC ===')
    try:
        # Tudo que pode gerar erro fica dentro do bloco try
        peso = float(input('Digite o peso em KG (ex: 75.8): '))
        altura = float(input('Digite sua altura em metros (ex: 1.80): '))

        # Validação lógica
        if altura <= 0 or peso <= 0:
            print('Erro: Os valores devem ser maiores que zero.')
            return

        # Chamada das funções
        resultado = calcular_imc(peso, altura)
        classificacao = obter_classificacao(resultado)

        # Exibição
        print(f'/nSeu IMC é {resultado:.1f}')
        print(f'Classificação: {classificacao}')

    except ValueError:
        # Captura se o usuário digitar letras ou usar vírgula em vez de ponto
        print('Erro: Entrada Inválida. Use apenas números e ponto.')

if __name__ == "__main__":
    executar_calculadora()
